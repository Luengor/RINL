@startuml VerificarCorreo

!include common.puml
participant "User" as UserEntity %lighten("#IndianRed", 20)

Auth -> DataForm : Pulsa el botón de verificar en el correo enviado
DataForm -> ApiClient : verifyEmail(token)
ApiClient -> UserR : POST /verify

alt Token válido
    alt Nuevo correo electrónico
        UserR -> UserDAO : update_user(email, new_email)
        UserDAO -> UserSchema : update(email, new_email)

    else Verificación
        autoactivate off
        UserR -> UserDAO : verify_user(email)
        UserDAO -> UserSchema : update(email, verify)
    end
    autoactivate on

    UserSchema --> UserDAO : ok
    UserDAO --> UserR : ok

    autoactivate off
    UserR --> ApiClient : ok
    ApiClient --> DataForm : ok

    DataForm --> Auth : Muestra un mensaje de éxito

else Token inválido
    autoactivate on
    UserR --> ApiClient : 400 Invalid verification token
    ApiClient --> DataForm : error
    DataForm --> Auth : Muestra un mensaje de error
end


@enduml
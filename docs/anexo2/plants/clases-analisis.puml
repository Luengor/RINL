@startuml ClasesAnalisis

' Cosas bonitas
skinparam linetype ortho
' skinparam class {
'     BackgroundColor #7ACFF5
' }
hide circle
skinparam classAttributeIconSize 0
skinparam roundCorner 0
left to right direction

''' El modelo
package "Modelo del Dominio" %lighten("#IndianRed", 40) {
    class "User" <<Entity>> %lighten("#IndianRed", 20) {
        + email: String
        + hashed_password: String
        + verified: Boolean
        + name: String
        + year_of_birth: Integer
    }

    class "Activity" <<Entity>> %lighten("#IndianRed", 20) {
        + date: Date
        + minigame: String
        + duration: Float
        + score: Float
        + activity_points: Float
        + extra_data: String
    }

    class "Shape" <<Entity>> %lighten("#IndianRed", 20) {
        + date: Date
        + weight: Float
        + height: Float
    }

    ' Un usuario puede tener muchas actividades y formas físicas
    User "1" --- "0..*" Activity : Realiza >
    User "1" --- "0..*" Shape : Registra >
}

''' El Backend está compuesto por routers
package "Backend" %lighten("#LightBlue", 20) {
    class "UserService" <<Control>> #LightBlue {
        + get_user(uuid: Integer): User
        + create_user(user: User): User
        + update_user(user: User): User
        + delete_user(uuid: Integer): void
    }

    class "ActivityService" <<Control>> #LightBlue {
        + get_activity(uuid: Integer): Activity
        + create_activity(activity: Activity): Activity
        + update_activity(activity: Activity): Activity
        + delete_activity(uuid: Integer): void
    }

    class "ShapeService" <<Control>> #LightBlue {
        + get_shape(uuid: Integer): Shape
        + create_shape(shape: Shape): Shape
        + update_shape(shape: Shape): Shape
        + delete_shape(uuid: Integer): void
    }
}

''' El Frontend es una aplicación web
package "Frontend" %lighten("#LightGreen", 20) {
    class "UserInterface" <<Boundary>> #LightGreen {}
    class "ActivityInterface" <<Boundary>> #LightGreen {}
    class "ShapeInterface" <<Boundary>> #LightGreen {}

    class "UnityInterface" <<Boundary>> #LightGreen {
        + send_message()
        + receive_message()
    }
}

''' Unity es independiente y se comunica con el frontend
package "Unity" #LightYellow {
    class "Game" <<Control>> #BUSINESS {
        + start_game()
        + end_game()
    }

    class "FrontendInterface" <<Boundary>> #BUSINESS {
        + send_message()
        + receive_message()
    }
}

''' Los servicios gestionan el modelo
UserService .> User : manages >
ActivityService ..> Activity : manages >
ShapeService .> Shape : manages >

''' Las interfaces del frontend interactúan con los servicios
UserInterface .> UserService : interacts >
ActivityInterface .> ActivityService : interacts >
ShapeInterface .> ShapeService : interacts >

''' Unity interactúa con el frontend
UnityInterface <.> FrontendInterface : communicates

''' El juego de Unity interactúa con el frontend
Game <..> FrontendInterface : communicates

@enduml
